# Copie este arquivo para .env e preencha os valores antes de executar.
# Nunca publique o arquivo .env real.

# Aplicação
FLASK_ENV=development
APP_ENV=development
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA
PORT=5000

# Banco local (deixe vazio para SQLite). Em produção, configure PostgreSQL.
DATABASE_URL=

# Conta administrativa inicial. Troque a senha antes de publicar.
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# E-mail transacional (opcional no desenvolvimento)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mercado Pago (opcional; necessário somente se ativar assinaturas)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:5000
